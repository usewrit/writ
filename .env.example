# =============================================================================
# Self-hosted Writ coordinator — environment
# =============================================================================
# 1. Copy this file:            cp .env.example .env
# 2. Fill in the secrets below (see the generator commands next to each).
# 3. Bring it up:               docker compose -f docker/docker-compose.yml \
#                                   --env-file .env up -d --build
# 4. Open http://localhost:8000 and log in with WRIT_ADMIN_* below.
#
# Data (the SQLite DB + your files) lives on the `writ-data` Docker volume, so
# it survives container recreation. There is NO separate database or Redis
# container — the coordinator runs on a single SQLite file with an in-process
# fakeredis. It runs no browsers; browser work goes to your `writ-agent` fleet.
# =============================================================================


# -----------------------------------------------------------------------------
# SECRETS  (REQUIRED — the coordinator will NOT boot with the shipped defaults)
# -----------------------------------------------------------------------------
# Secure-by-default: startup FAILS if API_SECRET_KEY / JWT_SECRET_KEY is left at
# a shipped default — or left BLANK, or is shorter than 32 characters — in EVERY
# environment. A blank signing key is the dangerous case: HS256 signs happily with
# a zero-length key, so an unfilled template would hand anyone the ability to forge
# an administrator session. Generate real secrets below (openssl rand -hex 32)
# before first boot. The ONLY exception is a throwaway LOCAL trial: set
# ENVIRONMENT=development AND ALLOW_INSECURE_DEV=true (see below) to boot with the
# insecure default key (tokens are then signed with a PUBLIC, forgeable key — never
# do this on anything reachable from a network).
#
# Easiest path: don't fill these in by hand. Run  ./scripts/gen-env.sh  which
# writes this file with every secret below freshly generated.

# JWT signing key. Used to sign/verify all session + API tokens.
#   Generate:  openssl rand -hex 32
# WRIT_JWT_SECRET is the operator-facing name; the compose file maps it onto
# the JWT_SECRET_KEY the app actually reads. Set WRIT_JWT_SECRET (leave
# JWT_SECRET_KEY blank) OR set JWT_SECRET_KEY directly — not both.
WRIT_JWT_SECRET=
JWT_SECRET_KEY=

# General API secret (token generation) and HMAC secret (signature checks).
#   Generate each:  openssl rand -hex 32
API_SECRET_KEY=
HMAC_SECRET_KEY=

# Fernet key that encrypts stored secrets/credentials at rest.
#   Generate:  python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   *** BACK THIS UP SECURELY. Losing it makes every stored secret unreadable. ***
SECRET_ENCRYPTION_KEY=

# Shared secret used to mint fleet-connect tokens for your writ-agent fleet
# (Fleet -> Connect a new agent). Fleet token minting fails without it.
#   Generate:  openssl rand -hex 32
RECORDER_AUTH_SECRET=

# Service-to-service secrets guarding the coordinator's internal endpoints.
# /internal/* can return DECRYPTED AI provider keys, so these are not optional:
# with ENVIRONMENT=production the coordinator refuses to boot unless both are
# set to strong, non-default values.
#   Generate each:  openssl rand -hex 32
INTERNAL_API_SECRET=
GATEWAY_SECRET=


# -----------------------------------------------------------------------------
# DOCUMENT + OCR EXTRACTION
# -----------------------------------------------------------------------------
# The `doc-extract` service reads PDFs, Word/Excel/PowerPoint files and scanned
# pages so a crawl can collect them instead of skipping them. It ships in this
# bundle and `docker compose up` starts it — you do not have to configure
# anything here for it to work.
#
# The shared secret below is presented by callers and checked by the service.
# With ENVIRONMENT=production it refuses to boot on an empty or well-known one.
#   Generate:  openssl rand -hex 32
DOC_EXTRACT_SECRET=

# Where that service is, AS YOUR AGENTS SEE IT — agents call it directly; the
# coordinator never does. The coordinator hands this address to each agent when
# it connects, which is the whole reason the lane works without extra setup.
#
# Leave it as-is when your agents run on this same host. Agents on OTHER
# machines cannot reach a loopback address here, so give them a routable one
# (put it behind the same reverse proxy as the coordinator). Blank turns the
# lane off: crawls then skip every non-HTML resource, silently and safely.
DOC_EXTRACT_URL=http://127.0.0.1:8092

# auto = read the text layer when there is one and OCR only true scans/images
# (direct extraction is exact and free, so this is almost always what you want).
# off = never OCR.  force = OCR every page even when text is already there.
DOC_EXTRACT_OCR_MODE=auto


# -----------------------------------------------------------------------------
# DEPLOYMENT IDENTITY
# -----------------------------------------------------------------------------

# Public base URL of THIS coordinator — the single most important production
# setting, and the one everything else is derived from:
#
#   * agents dial back on it, and it is baked into the `curl .../agent.sh`
#     one-liner the Fleet page shows you (leave it at localhost and every agent
#     you enrol from another machine will fail to connect);
#   * its hostname is automatically trusted by the Host-header allowlist, so
#     setting THIS is enough — you do not also have to fill in ALLOWED_HOSTS;
#   * absolute links in emails and OAuth metadata use it.
#
# Use your real https URL in production (e.g. https://writ.example.com);
# http://localhost:8000 is fine for a local try. Required when
# ENVIRONMENT=production — the coordinator refuses to boot without it.
#
# `./scripts/deploy.sh writ.example.com you@example.com` sets this, and every
# other domain setting below, for you.
WRIT_PUBLIC_URL=http://localhost:8000

# Host ports the compose stack publishes on. Change these when 8000 or 8092 is
# already taken on this machine (another dev stack, another coordinator) instead
# of editing docker/docker-compose.yml, which turns into a permanent local diff.
#
# If you change WRIT_HOST_PORT, change WRIT_PUBLIC_URL above to match. Agents
# dial the URL, so when the two drift the fleet simply stays empty and nothing
# in the logs says why. Likewise, changing WRIT_DOC_EXTRACT_HOST_PORT means
# setting DOC_EXTRACT_URL — an agent that cannot reach the extractor does not
# error, it silently skips every PDF and scanned page.
WRIT_HOST_PORT=8000
WRIT_DOC_EXTRACT_HOST_PORT=8092

# ── Public deployment: TLS (the `tls` compose profile) ───────────────────────
# These three are read by the bundled Caddy reverse proxy, which is started ONLY
# by `docker compose --profile tls up -d`. Caddy obtains a Let's Encrypt
# certificate for WRIT_DOMAIN and renews it by itself — no certbot, no cron.
# scripts/deploy.sh fills these in; see docs/DEPLOYMENT.md.
#
# The hostname users open. Must already resolve (A/AAAA) to this server's public
# IP before you bring the profile up, or ACME issuance fails.
WRIT_DOMAIN=
# Contact address Let's Encrypt uses for expiry and issuance-failure notices.
WRIT_ACME_EMAIL=
# Which ACME directory to issue from. Leave this alone unless you are debugging:
# the staging directory below issues UNTRUSTED certificates but has far looser
# rate limits, so it is the right one to hammer while sorting out DNS/firewall.
#   https://acme-staging-v02.api.letsencrypt.org/directory
# Must never be blank — Caddy needs a real URL here. `deploy.sh --staging`
# switches it for you and switches it back on the next normal run.
WRIT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
# OPTIONAL, and only needed when agents run on OTHER machines: a second hostname
# routed to the document/OCR extractor. Agents call that service directly, so a
# remote agent needs an address of its own. Leave blank if all your agents run on
# this host. Set DOC_EXTRACT_URL to the matching https:// URL when you use it.
WRIT_DOC_EXTRACT_DOMAIN=

# Where the complete corresponding SOURCE of this build can be obtained.
#
# Writ is AGPL-3.0-only, and §13 of that license says anyone who interacts with
# this coordinator over a network is entitled to the source of the version they
# are talking to. The app makes that offer for you: it serves GET /api/about and
# links it from the login screen and Settings → General.
#
# Leave it alone if you run the released build unmodified. If you PATCH the
# coordinator and let anyone else use it over a network, point this at your own
# repository — upstream is no longer the source of what you are running.
WRIT_SOURCE_URL=https://github.com/usewrit/writ

# development | production. Default is production: the safe posture for any
# deployed or internet-reachable instance.
#   - production:  (default) enforces strong secrets, requires WRIT_PUBLIC_URL,
#                  enforces the Host allowlist, and rejects CORS '*'. Generate
#                  strong API_SECRET_KEY / JWT secret (openssl rand -hex 32) and
#                  run behind TLS with a real domain.
#   - development: relaxed posture for a quick LOCAL trial only — set
#                  ENVIRONMENT=development (and optionally ALLOW_INSECURE_DEV=true
#                  to boot with throwaway shipped secrets; see below). Never use
#                  on anything reachable from a network.
ENVIRONMENT=production

# Allow monitored/crawled/webhook targets on private or internal IP ranges
# (loopback, RFC1918, link-local/cloud-metadata). SSRF screening is ON by
# default in EVERY environment — including development. Set true ONLY if this
# coordinator must legitimately monitor intranet apps; all other SSRF screens
# (scheme checks, DNS pinning, redirect re-validation) stay active regardless.
ALLOW_PRIVATE_TARGETS=false

# Local-trial escape hatch ONLY. When true AND ENVIRONMENT=development, the
# coordinator will boot with the shipped DEFAULT API/JWT signing secret instead of
# failing closed — tokens are then signed with a PUBLIC, forgeable key. Ignored in
# every non-development environment. Leave false (blank) and generate real secrets
# above for anything beyond a throwaway local test.
ALLOW_INSECURE_DEV=false

# Which upstream peers uvicorn trusts to set X-Forwarded-For / -Proto. Default
# '127.0.0.1' trusts only a loopback reverse proxy, so a direct client cannot spoof
# its source IP and defeat per-IP controls (rate-limit / IP-ban). NEVER '*' on an
# internet-reachable deployment.
#
# GET THIS RIGHT WHEN YOU PUT A PROXY IN FRONT. If the proxy's address is not
# listed, every request appears to come from the proxy: all clients then share a
# single rate-limit bucket, one attacker's failed logins lock out everyone, and
# audit logs record the proxy's IP instead of the caller's.
#
# The bundled Caddy runs on the compose network, not on loopback, which is why
# the `tls` profile needs the container range added:
#   FORWARDED_ALLOW_IPS=127.0.0.1,172.16.0.0/12
# scripts/deploy.sh sets exactly that. Trusting the private container range is
# safe here because the coordinator's only other exposure is 127.0.0.1:8000 on
# the host — nothing on a public interface reaches it directly.
FORWARDED_ALLOW_IPS=127.0.0.1

# EXTRA hostnames this coordinator answers on (comma-separated, no scheme, no
# port). You usually do NOT need this: WRIT_PUBLIC_URL's hostname is trusted
# automatically, and so is loopback (the container healthcheck curls localhost).
#
# Set it only for additional names — a vanity alias, a second hostname, or a
# wildcard like *.writ.example.com. Enforced when ENVIRONMENT=production; in
# development any Host is accepted. Editable at runtime under
# Settings → Network → Trusted hosts, which applies without a restart.
ALLOWED_HOSTS=

# Explicit CORS origins (comma-separated). In production '*' is refused.
# The single container serves the SPA and the API from the SAME origin, so the
# browser makes no cross-origin calls and this matters only for API clients you
# run from another web page. Set it to your public URL when you deploy:
#   CORS_ORIGINS=https://writ.example.com
CORS_ORIGINS=http://localhost:8000

# ── Abuse control: global per-IP request ceiling ─────────────────────────────
# A blanket backstop across the whole HTTP surface, on top of the much stricter
# per-path limits (login/password-reset brute-force lockout, single-use agent
# pairing codes, inbound webhooks). Deliberately generous — this exists to stop
# a host hammering the coordinator flat, not to meter usage. Static assets, the
# healthcheck and CORS preflights are exempt.
#
# Only lower it if you know your traffic shape: one browser tab loading the app
# and polling already spends tens of requests a minute. Set ENABLED=false if a
# proxy or WAF in front already enforces a ceiling.
GLOBAL_RATE_LIMIT_ENABLED=true
GLOBAL_RATE_LIMIT_REQUESTS=600
GLOBAL_RATE_LIMIT_WINDOW=60

# uvicorn log level: critical | error | warning | info | debug | trace
LOG_LEVEL=info

# Serve the OpenAPI schema (/openapi.json) and the interactive docs (/docs,
# /redoc). OFF in production, on in development — the schema enumerates every
# route and answers without authentication, which is a free map of the API for
# anyone who reaches the host. Nothing in the app reads it at runtime, so
# leaving it off breaks nothing. Set true if you want to generate a client
# against your own deployment.
# WRIT_EXPOSE_OPENAPI=false


# -----------------------------------------------------------------------------
# FIRST-BOOT ADMIN  (optional, idempotent)
# -----------------------------------------------------------------------------
# If NO user exists yet and both email + password are set, the coordinator
# provisions the single owner/admin automatically on first boot. Ignored once
# an account exists. Leave WRIT_ADMIN_PASSWORD BLANK to instead complete the
# in-app first-run onboarding (open the app and create your password there);
# WRIT_ADMIN_EMAIL is then just the email prefilled on that setup page.
WRIT_ADMIN_EMAIL=admin@example.com
WRIT_ADMIN_PASSWORD=
# Optional display name for the bootstrapped admin.
WRIT_ADMIN_NAME=Administrator


# -----------------------------------------------------------------------------
# FLEET AGENT HINTS  (shown in the UI at Fleet -> Connect a new agent)
# -----------------------------------------------------------------------------
# Where operators download the writ-agent binary and which Docker image to run.
# Defaults point at the public writ-agent project; override to pin your own.
WRIT_AGENT_RELEASES_URL=https://github.com/usewrit/writ-agent/releases
WRIT_AGENT_DOCKER_IMAGE=ghcr.io/usewrit/writ-agent:latest


# -----------------------------------------------------------------------------
# STORAGE PATHS
# -----------------------------------------------------------------------------
# These are pinned to the persistent /data volume by docker-compose.yml and do
# NOT need to be set here. Listed for reference only:
#   WRIT_DB_PATH=/data/writ.db      # SQLite database file
#   WRIT_FILES_DIR=/data/files      # tenant file bytes
#   WRIT_UI_DIR=/app/ui             # built SPA (baked into the image)


# -----------------------------------------------------------------------------
# MCP SERVER  (/mcp — connect AI agents to this coordinator)
# -----------------------------------------------------------------------------
# Ceiling on derived run_<workflow> tools (workflows pinned via the MCP
# writ_pin_workflow_tool tool or the workflow's mcp_tool_pinned setting;
# exposure is opt-in, default off). MCP clients inject every advertised tool
# schema into model context on every request, and several cap the total tool
# count, so keep this modest. Workflows past the cap stay callable via
# writ_run_workflow. 0 disables derived tools entirely.
MCP_DERIVED_TOOL_CAP=20
