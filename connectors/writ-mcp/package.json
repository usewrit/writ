  "bin": {
    "writ-mcp": "index.js"
  },
  "files": [
    "index.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "writ",
    "claude",
    "browser-automation",
    "workflows"
  ],
  "publishConfig": {
