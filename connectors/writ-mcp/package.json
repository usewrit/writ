  "license": "MIT",
  "author": "The Writ Project Authors",
  "homepage": "https://usewrit.app",
  "bugs": {
    "url": "https://github.com/usewrit/writ/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usewrit/writ.git",
    "directory": "connectors/writ-mcp"
  },
