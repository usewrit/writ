# =============================================================================
# Coordinator environment (running the Python app directly, e.g. via run-local.sh
# or `python serve.py`). For the Docker path use the top-level selfhost/.env.example
# instead — docker-compose reads that one. This file is only a reference for a
# bare, non-Docker run of the coordinator.
#
# The coordinator stores everything in ONE SQLite file and uses an in-process
# fakeredis — there is NO Postgres and NO Redis server to configure. Browser work
# is dispatched to your writ-agent fleet; this process runs no browsers.
# =============================================================================

# --- Storage (SQLite; NOT a database server) ---------------------------------
# Path to the SQLite .db file. `database_url` is derived from this — you never set
# a DATABASE_URL. Use an absolute path in a container (e.g. /data/writ.db).
WRIT_DB_PATH=./writ.db
# Directory for stored file bytes (uploads/exports).
WRIT_FILES_DIR=./data/files
# Directory of the built SPA that the coordinator serves at / (../frontend/dist).
WRIT_UI_DIR=../frontend/dist

# --- Secrets (generate real values; never commit them) -----------------------
# JWT signing key (signs/verifies all session + API tokens).  openssl rand -hex 32
JWT_SECRET_KEY=
# General API secret + HMAC signature secret.                  openssl rand -hex 32
API_SECRET_KEY=
HMAC_SECRET_KEY=
# Fernet key that encrypts stored secrets/credentials at rest.
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   *** BACK THIS UP. Losing it makes every stored secret unreadable. ***
SECRET_ENCRYPTION_KEY=
# Shared secret used to mint fleet-connect tokens (Fleet -> Connect a new agent).
#   openssl rand -hex 32
RECORDER_AUTH_SECRET=

# --- Deployment identity -----------------------------------------------------
# Public base URL of THIS coordinator (handed to agents as their gateway URL).
WRIT_PUBLIC_URL=http://localhost:8000
# development | production. production enforces strong secrets + ALLOWED_HOSTS
# and rejects CORS '*'; development relaxes those checks and is for a LOCAL trial
# only. The repository-root .env.example (used by the Docker quickstart) defaults
# to production — keep these two in agreement when you deploy.
ENVIRONMENT=production
# Service-to-service secrets. REQUIRED when ENVIRONMENT=production: /internal/*
# can return decrypted AI provider keys.
#   openssl rand -hex 32   (each)
INTERNAL_API_SECRET=
GATEWAY_SECRET=
# HTTP host/port serve.py binds. 0.0.0.0 is correct INSIDE a container (the port
# mapping decides real exposure, and docker-compose publishes to 127.0.0.1). If
# you run this directly on a host, bind 127.0.0.1 and put a TLS reverse proxy in
# front — see docs/DEPLOYMENT.md.
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# --- First-boot admin (optional) ---------------------------------------------
# If NO user exists yet AND both are set, the single owner/admin is provisioned
# on boot. Leave WRIT_ADMIN_PASSWORD blank to instead complete the in-app
# onboarding (create your password on first visit). Idempotent once an owner exists.
WRIT_ADMIN_EMAIL=admin@local
WRIT_ADMIN_PASSWORD=
WRIT_ADMIN_NAME=Owner
