# TLS terminator for a public Writ coordinator.
#
# Used only by the `tls` compose profile (`docker compose --profile tls up -d`),
# which scripts/deploy.sh drives for you. A plain `docker compose up -d` does not
# start Caddy at all, so the local quickstart keeps its loopback-only shape and
# never grabs ports 80/443.
#
# Caddy obtains and RENEWS a Let's Encrypt certificate on its own — there is no
# certbot, no renewal cron, and no reload hook to forget. Certificates and the
# ACME account key live on the `caddy-data` volume; back it up or, if you lose
# it, Caddy simply re-issues on next start (mind Let's Encrypt's rate limits:
# 5 duplicate certificates per week).
#
# Every value comes from your .env:
#   WRIT_DOMAIN            the hostname users open, e.g. writ.example.com
#   WRIT_ACME_EMAIL        contact address for expiry notices from Let's Encrypt
#   WRIT_DOC_EXTRACT_DOMAIN  optional; only needed when agents run on OTHER hosts
{
	# Let's Encrypt emails this address before a certificate expires and if
	# issuance starts failing. Blank is legal but means silent failures.
	email {$WRIT_ACME_EMAIL}

	# The ACME directory to issue from. Normally Let's Encrypt production; the
	# staging directory issues UNTRUSTED certificates but has far looser rate
	# limits, which is what you want while debugging a deploy
	# (`./scripts/deploy.sh <domain> <email> --staging` switches it).
	#
	# Note the default below is a full URL, not a blank: Compose passes an empty
	# .env value through as set-but-empty, and Caddy's `{$VAR:default}` only
	# falls back when a variable is UNSET — so a blank WRIT_ACME_CA would leave
	# this directive with no argument and fail the config parse.
	acme_ca {$WRIT_ACME_CA:https://acme-v02.api.letsencrypt.org/directory}

	# Deliberately NOT setting `trusted_proxies` here. Caddy is the edge: no
	# X-Forwarded-For arriving from outside may be believed, or a client could
	# hand us any source IP it liked and walk straight through the per-IP rate
	# limit and the login brute-force lockout. Caddy's default is to trust
	# nothing, which is what we want. If you put Cloudflare (or another CDN) in
	# FRONT of this, add a `servers { trusted_proxies ... }` block naming only
	# that provider's ranges.
}

{$WRIT_DOMAIN} {
	encode zstd gzip

	reverse_proxy coordinator:8000 {
		# The agent fleet holds a long-lived WebSocket at /ws/… . Caddy proxies
		# Upgrade requests transparently and applies no read timeout to a
		# streaming response, so those sockets stay up without extra config —
		# this is the main reason the bundled proxy is Caddy and not nginx,
		# where forgetting `proxy_read_timeout` silently kills the fleet after
		# 60 seconds.
		#
		# X-Forwarded-For / -Proto / -Host are set automatically. The
		# coordinator only BELIEVES them when FORWARDED_ALLOW_IPS covers this
		# container's address — scripts/deploy.sh sets that to the compose
		# network range. Without it every client shares one rate-limit bucket
		# and every audit log records Caddy's IP.
	}
}

# Document/OCR extraction, for agents that DO NOT run on the coordinator host.
#
# Agents call this service directly with bytes they already fetched (the
# coordinator never calls it), so an agent on another machine needs a routable
# address of its own. Set WRIT_DOC_EXTRACT_DOMAIN and point DOC_EXTRACT_URL at
# the same https:// URL; see docs/DEPLOYMENT.md.
#
# The default below is a `.localhost` name on purpose: Caddy issues those from
# its own internal CA and never contacts Let's Encrypt, so leaving this unset
# costs nothing and cannot burn ACME rate limits on a name that does not resolve.
{$WRIT_DOC_EXTRACT_DOMAIN:doc-extract.localhost} {
	encode zstd gzip
	# DOC_EXTRACT_SECRET is the ONLY thing in front of this service once it is
	# reachable over a network. It is generated by scripts/gen-env.sh and the
	# service refuses to boot without it in production.
	reverse_proxy doc-extract:8092
}
