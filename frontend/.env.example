# Dev proxy target — the Vite dev server proxies /api and /ws to this
# coordinator URL (see vite.config.ts). Defaults to http://127.0.0.1:8000.
# VITE_COORDINATOR_URL=http://127.0.0.1:8000

# Optional override for the origin shown in copyable webhook/snippet URLs.
# NOT the API base — requests always go same-origin to /api. Falls back to
# window.location.origin when unset.
# VITE_API_URL=https://writ.example.com

# Base URL for the "read the docs" links in the UI. Every documentation
# affordance routes through utils/docs.ts, so this one value moves all of them.
# Point it at your own documentation if you fork, or if the upstream site is not
# where your readers should land.
# VITE_DOCS_BASE=https://usewrit.app/docs
